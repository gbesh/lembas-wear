<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Updates (itself and the watch face) from the public GitHub releases -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The app list -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Lembas tile: the Shire date, the mealtime and your recent apps -->
        <service
            android:name=".LembasTile"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Your day: the sun arc, sunrise, sunset and the next look -->
        <service
            android:name=".DayTile"
            android:exported="true"
            android:label="Lembas day"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- The hourly (or mealtime) tap on the wrist -->
        <receiver android:name=".Chime$Tap" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- The look, in step with the phone -->
        <service android:name=".PhoneLookListener" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/lembas/look" />
            </intent-filter>
        </service>

        <!-- The look, for the Lembas watch face (it trusts only Lembas's own face) -->
        <service
            android:name=".LookComplication"
            android:exported="true"
            android:label="Lembas look"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="RANGED_VALUE,SHORT_TEXT" />
            <!-- every five minutes as well, so the calendar (Durin's Day, the feasts), the sky and the night watch reach the face on time -->
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
            <meta-data android:name="android.support.wearable.complications.SAFE_WATCH_FACES" android:value="com.middleearth.launcher.watchface" />
            <meta-data android:name="android.support.wearable.complications.SAFE_WATCH_FACE_SUPPORTED_TYPES" android:value="SHORT_TEXT" />
        </service>

        <!-- Lembas complications for any watch face -->
        <service
            android:name=".ShireDateComplication"
            android:exported="true"
            android:label="Shire date"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
        </service>

        <service
            android:name=".MealComplication"
            android:exported="true"
            android:label="Hobbit mealtime"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
        </service>

        <service
            android:name=".FeastComplication"
            android:exported="true"
            android:label="Next feast"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="3600" />
        </service>

        <service
            android:name=".NextLookComplication"
            android:exported="true"
            android:label="Next Lembas look"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
        </service>

        <!-- The Horn of Gondor, the Phial of Galadriel and smoke-ring focus: tiles, and what they open -->
        <activity android:name=".HornActivity" android:exported="false" android:taskAffinity="" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity android:name=".PhialActivity" android:exported="false" android:taskAffinity="" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity android:name=".FocusActivity" android:exported="false" android:taskAffinity="" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <service
            android:name=".HornTile"
            android:exported="true"
            android:label="Horn of Gondor"
            android:description="@string/app_name"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_preview" />
        </service>
        <service
            android:name=".PhialTile"
            android:exported="true"
            android:label="Phial of Galadriel"
            android:description="@string/app_name"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_preview" />
        </service>
        <service
            android:name=".FocusTile"
            android:exported="true"
            android:label="Smoke-ring focus"
            android:description="@string/app_name"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_preview" />
        </service>
        <!-- The walk to Mount Doom, and the hobbit forecast, for any watch face -->
        <service
            android:name=".JourneyComplication"
            android:exported="true"
            android:label="The walk to Mount Doom"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="1800" />
        </service>
        <service
            android:name=".ForecastComplication"
            android:exported="true"
            android:label="Hobbit forecast"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="LONG_TEXT,SHORT_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="1800" />
        </service>

        <service
            android:name=".WearUpdater$UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".WearUpdater$InstallResult"
            android:exported="false" />
    </application>
</manifest>
